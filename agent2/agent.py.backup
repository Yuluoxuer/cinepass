"""主Agent类 - 使用LangChain create_agent (1.3.14新API)"""
from __future__ import annotations
from typing import Optional
from langchain.agents import create_agent
from config import get_settings
import checkpoint as cp
from tools import get_all_tools
from llm import get_llm


class MovieTicketAgent:
    """电影票务Agent"""
    
    def __init__(self):
        self.settings = get_settings()
        self.llm = get_llm()
        self.tools = get_all_tools()
        
        # 使用LangChain 1.3.14的create_agent
        self.agent = create_agent(
            model=self.llm,
            tools=self.tools,
            system_prompt="""你是一个专业的电影票务智能助手，可以帮助用户查询电影、影院、场次信息，并完成订票流程。

你的能力包括：电影信息、影院信息、场次查询、座位管理、订单操作等。

工作流程：订票需要先查电影→查场次→查座位→锁座→创建订单。
注意：使用工具前先理解用户意图，返回结果要清晰易懂。"""
        )
    
    async def initialize(self):
        """初始化Agent"""
        await cp.init_pool()
        await cp.create_tables()
    
    async def run(
        self,
        message: str,
        session_id: str,
        user_id: Optional[str] = None,
        **context
    ) -> str:
        """运行Agent处理用户消息"""
        await cp.create_session(session_id, user_id, context)
        
        # 加载历史消息
        history_msgs = await cp.load_messages(session_id, limit=self.settings.memory_window)
        
        # 转换为messages格式
        messages = []
        for msg in history_msgs:
            messages.append({"role": msg["role"], "content": msg["content"]})
        
        # 添加当前消息
        messages.append({"role": "user", "content": message})
        
        try:
            # 执行Agent
            result = await self.agent.ainvoke({"messages": messages})
            
            # 获取最后一条assistant消息
            response = ""
            if result and "messages" in result:
                for msg in reversed(result["messages"]):
                    if msg.get("role") == "assistant":
                        response = msg.get("content", "")
                        break
            
            if not response:
                response = "抱歉，我无法处理这个请求。"
            
            # 保存消息
            await cp.save_message(session_id, "user", message)
            await cp.save_message(session_id, "assistant", response)
            
            return response
            
        except Exception as e:
            error_msg = f"处理请求时出错: {str(e)}"
            await cp.save_message(session_id, "user", message)
            await cp.save_message(session_id, "assistant", error_msg)
            return error_msg
    
    async def close(self):
        """关闭Agent资源"""
        await cp.close_pool()


_agent: Optional[MovieTicketAgent] = None

async def get_agent() -> MovieTicketAgent:
    """获取全局Agent实例"""
    global _agent
    if _agent is None:
        _agent = MovieTicketAgent()
        await _agent.initialize()
    return _agent
