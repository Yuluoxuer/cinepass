{
  "info": {
    "name": "购票辅助 Agent 接口测试",
    "description": "测试购票辅助 Agent：普通问答 / 购票引导 / BookingDraft 记忆。\n\n使用说明：\n1. 先启动 agent 服务：cd /home/rei/Code/FastAPIAgent && conda run -n langchain python -m uvicorn agent.api:app --port 8001\n2. 在 Postman 中把 baseUrl 变量设为 http://localhost:8001\n3. 多轮对话测试：按顺序发送【购票流程】下的请求，它们共用 session_id=test-booking-001，可验证记忆\n4. 如需测试锁座/下单，在请求头 Authorization 填入真实 JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. 基础",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "验证 agent 服务是否存活"
          }
        },
        {
          "name": "查看购票草稿",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking-draft/test-booking-001",
            "description": "查看 test-booking-001 会话当前已记录的购票草稿"
          }
        }
      ]
    },
    {
      "name": "1. 普通问答（不购票）",
      "item": [
        {
          "name": "查热映电影",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"最近有什么热映的电影？\",\n  \"session_id\": \"test-chat-001\"\n}"
            },
            "description": "预期：agent 调用 searchMovies(status=hot_showing) 返回热映影片，不强行引导购票"
          }
        },
        {
          "name": "查电影详情",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"推荐几部高分电影吧\",\n  \"session_id\": \"test-chat-001\"\n}"
            },
            "description": "预期：agent 调用 recommendMovies 返回推荐影片"
          }
        }
      ]
    },
    {
      "name": "2. 购票流程（多轮 · 验证记忆）",
      "item": [
        {
          "name": "步骤1：一句话含多个要点",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "disabled": true }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"我想看《流浪地球2》，帮我找今天附近评分最高的电影院\",\n  \"session_id\": \"test-booking-001\",\n  \"latitude\": 39.9042,\n  \"longitude\": 116.4074\n}"
            },
            "description": "预期：agent 识别出电影+时间+影院偏好三个信息点，调用 searchMovies + searchCinemas，并 updateBookingDraft 记录"
          }
        },
        {
          "name": "步骤2：补充影院/场次/票数",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "disabled": true }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"就选第一个影院吧，晚上7点左右的场次，2张票\",\n  \"session_id\": \"test-booking-001\"\n}"
            },
            "description": "预期：agent 通过 getBookingDraft 读取已有草稿，不重复询问电影，补充影院/时间/票数"
          }
        },
        {
          "name": "步骤3：确认并尝试下单",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "disabled": true }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"确认，帮我锁座下单\",\n  \"session_id\": \"test-booking-001\"\n}"
            },
            "description": "预期：agent 执行 listShows → recommendSeats → lockSeats → createOrder（需携带 JWT）"
          }
        },
        {
          "name": "步骤4：查看草稿是否清空",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking-draft/test-booking-001",
            "description": "下单成功后 clearBookingDraft，草稿应为空"
          }
        }
      ]
    },
    {
      "name": "3. 带 JWT 测试登录操作",
      "item": [
        {
          "name": "查询当前登录用户",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"我是谁？\",\n  \"session_id\": \"test-auth-001\"\n}"
            },
            "description": "预期：agent 调用 getCurrentUser 查询当前登录用户（需在变量中配置真实 token）"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_HERE",
      "type": "string"
    }
  ]
}
