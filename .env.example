APP_NAME=ticket-agent
APP_VERSION=0.1.0
DEBUG=false

TICKET_API_BASE_URL=http://localhost:8080
TICKET_API_TIMEOUT_S=8

# Agent 自有库（对话 session/message）。默认 SQLite；生产示例：
# DATABASE_URL=postgresql+psycopg2://agent:pass@localhost:5432/ticket_agent
DATABASE_URL=sqlite:///./storage/agent.db

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=1.5
