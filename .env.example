APP_NAME=agent-service
APP_VERSION=0.2.0
DEBUG=false

# DeepSeek（OpenAI 兼容）：把 key 填到 OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_S=60

# 票务中台（Tools 出站，如 get_current_user → GET /api/v1/auth/me）
BACKEND_BASE_URL=http://127.0.0.1:8080
# CinemaAgent 使用该地址调用只读的 /api/v1/cinemas 接口。

# LangGraph 短期记忆（官方 AsyncPostgresSaver）；留空则关闭 checkpoint
# 例：postgresql://user:pass@127.0.0.1:5432/cinepass_agent
POSTGRES_URI=
